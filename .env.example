# ==============================================================================
# CelebrateOS — Master Environment Variable Template
# Copy this file to .env before starting the server.
# NEVER commit .env to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Persistence
# Connection string for MongoDB (Local instance or MongoDB Atlas cluster)
MONGODB_URI=mongodb://localhost:27017/celebrateos

# Authentication Security
# Generate a cryptographically strong secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Google Gemini API
# Server-side API key for AI plan generation and revision proposals.
# Keys are strictly kept on the server and never sent to the client.
GEMINI_API_KEY=replace_with_your_google_gemini_api_key

# Client Origin (CORS Whitelist)
CLIENT_ORIGIN=http://localhost:5173
